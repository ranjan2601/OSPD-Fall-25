# Dockerfile for Gemini AI Service
FROM python:3.11-slim

WORKDIR /app

# Install uv for dependency management
RUN pip install uv

# Copy workspace configuration
COPY pyproject.toml ./
COPY uv.lock ./

# Copy source code
COPY src/gemini_service ./src/gemini_service
COPY src/ai_client_api ./src/ai_client_api
COPY src/gemini_client_impl ./src/gemini_client_impl

# Install dependencies
RUN uv sync --no-dev --all-packages

# Expose port
EXPOSE 8000

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8000

# Run the service
CMD ["uv", "run", "python", "-m", "uvicorn", "gemini_service.api:app", "--host", "0.0.0.0", "--port", "8000"]
